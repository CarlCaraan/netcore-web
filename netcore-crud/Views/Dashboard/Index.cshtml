@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
            @ViewBag.Message

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <h4 class="mt-4">Dashboard</h4>

    <div class="row mt-4">

        <!-- Users by Group -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">
                        Users by GroupName
                    </h5>

                    <div style="height:400px;">
                        <canvas id="usersByGroupChart"></canvas>
                    </div>

                </div>
            </div>
        </div>


        <!-- Card Files by Type -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">

                    <h5 class="card-title">
                        CardFiles by Type
                    </h5>

                    <div style="height:400px;">
                        <canvas id="cardFilesByTypeChart"></canvas>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts
{
    <script src="/lib/chart.js/chart.umd.js"></script>

    <script>

        // =========================
        // USERS BY GROUP - PIE
        // =========================

        const userData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Users));

        const userLabels = userData.map(x => x.GroupName);
        const userValues = userData.map(x => x.UserCount);

        new Chart(
            document.getElementById('usersByGroupChart'),
            {
                type: 'pie',

                data: {
                    labels: userLabels,

                    datasets: [{
                        data: userValues,
                        borderWidth: 1
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            position: 'right'
                        },

                        title: {
                            display: true,
                            text: 'Users by GroupName'
                        }
                    }
                }
            }
        );


        // =========================
        // CARD FILES BY TYPE - BAR
        // =========================

        const cardFileData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CardFiles));

        const cardFileLabels = cardFileData.map(x => x.Type);
        const cardFileValues = cardFileData.map(x => x.TypeCount);

        new Chart(
            document.getElementById('cardFilesByTypeChart'),
            {
                type: 'bar',

                data: {
                    labels: cardFileLabels,

                    datasets: [{
                        label: 'Number of Card Files',
                        data: cardFileValues,
                        borderWidth: 1
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Type'
                            }
                        },

                        y: {
                            beginAtZero: true,

                            title: {
                                display: true,
                                text: 'Number of CardFiles'
                            },

                            ticks: {
                                precision: 0
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            display: false
                        },

                        title: {
                            display: true,
                            text: 'CardFiles by Type'
                        }
                    }
                }
            }
        );
    </script>

    @* CHART JS *@
    <script src="~/lib/chart.js/chart.umd.js"></script>
}
