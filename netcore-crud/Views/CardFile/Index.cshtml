@{
    ViewData["Title"] = "CardFile";
}
@model ModuleViewModel<CardFileModel>

<div class="module-header">


    <div class="module-title">
        <i class="bi bi-shield-lock-fill"></i>
        CARD FILE
        <span class="module-status">
            >>@Model.Common.Status
        </span>
    </div>

    <div class="module-toolbar">
        <form asp-action="New" method="post" class="d-inline">
            <button class="btn btn-sm btn-toolbar"><i class="bi bi-plus-lg"></i> New</button>
        </form>
        <button form="formSave" class="btn btn-sm btn-toolbar"><i class="bi bi-floppy"></i> Save</button>
        <form id="formDelete" asp-controller="CardFile" asp-action="Delete" method="post">
            <input type="hidden" name="Record.Code" value="@Model.Record.Code" />

            <button type="button" class="btn btn-sm btn-toolbar" onclick="confirmDelete()" disabled="@Model.Common.IsDisable">
                <i class="bi bi-trash"></i> Delete
            </button>
        </form>
        <a asp-action="Index" asp-route-PubPrimaryValue="" class="btn btn-sm btn-toolbar"> <i class="bi bi-file-earmark"></i>Clear</a>
        <button type="submit" form="formSave" formaction="@Url.Action("SearchModule")" class="btn btn-sm btn-toolbar"><i class="bi bi-search"></i> Search </button>
        <button class="btn btn-sm btn-toolbar" data-bs-toggle="modal" data-bs-target="#ViewListModal"><i class="bi bi-list-ul"></i> List</button>
    </div>

</div>

<div class="container-fluid mt-3">
    <!-- Message Alert -->
    @Model.Common.Message
    <h6>Main Information</h6>
    <div class="card">
        <div class="card-body">
            <form asp-action="Save" id="formSave" method="post" class="d-inline">
                @* HIDDEN FIELD *@
                <input asp-for="Common.Mode" type="hidden" />
                @* Original OriginalPubPrimary para ma-block ang pag-edit ng unique identifier. *@
                <input asp-for="Common.OriginalPubPrimary" type="hidden" />
                <div class="row">

                    <div class="col-md-8">
                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Card File Code<span class="fw-bold text-danger"> *</span></label>
                            <div class="col-md-4">
                                <input asp-for="Record.Code" placeholder="Card File" class="form-control form-control-sm" readonly="@(Model.Common.IsEdit || Model.Common.IsReadOnly)" />
                                <span asp-validation-for="Record.Code" class="text-danger validation-error d-block"></span>
                            </div>

                            <label class="col-md-2 col-form-label-sm text-end">Card Type<span class="fw-bold text-danger"> *</span></label>
                            <div class="col-md-4">
                                <select asp-for="Record.Type"
                                        asp-items="Model.Common.CardFileType"
                                        class="form-select form-select-sm searchable-select" disabled="@(Model.Common.IsDisable || Model.Common.IsEdit)">
                                    <option value=""></option>
                                </select>
                                @if (Model.Common.IsDisable)
                                {
                                    <input type="hidden" asp-for="Record.Type" />
                                }
                                <span asp-validation-for="Record.Type"
                                      class="text-danger validation-error d-block"></span>
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">
                                Category / Sub Type
                            </label>
                            <div class="col-md-10">
                                <select asp-for="Record.Category"
                                        asp-items="Model.Common.CardFileCategory"
                                        class="form-select form-select-sm searchable-select">
                                    <option value=""></option>
                                </select>

                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Company Name<span class="fw-bold text-danger"> *</span></label>
                            <div class="col-md-10">
                                <input asp-for="Record.Name" placeholder="Full Name / Company Name" class="form-control form-control-sm" />
                                <span asp-validation-for="Record.Name" class="text-danger validation-error d-block"></span>
                            </div>
                        </div>

                        <div class="border border-secondary border-dashed p-2 rounded mb-2">
                            <div class="text-primary fw-bold small">For Form 2307</div>
                            <div class="mb-2 row">
                                <label class="col-md-2 col-form-label-sm text-end">Last Name</label>
                                <div class="col-md-4">
                                    <input asp-for="Record.LastName" placeholder="Last Name" class="form-control form-control-sm" />
                                </div>
                                <label class="col-md-2 col-form-label-sm text-end">Middle Name</label>
                                <div class="col-md-4">
                                    <input asp-for="Record.MiddleName" placeholder="Middle Name" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="mb-2 row">
                                <label class="col-md-2 col-form-label-sm text-end">First Name</label>
                                <div class="col-md-4">
                                    <input asp-for="Record.FirstName" placeholder="First Name" class="form-control form-control-sm" />
                                </div>
                                <label class="col-md-2 col-form-label-sm text-end">Suffix</label>
                                <div class="col-md-4">
                                    <input asp-for="Record.Suffix" placeholder="Suffix" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Department</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Department" placeholder="Department" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">Division</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Division" placeholder="Division" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Ar Terms(Days)</label>
                            <div class="col-md-4">
                                <input asp-for="Record.ARTerms" placeholder="Ar Terms(Days)" type="number" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">Ap Terms (Days)</label>
                            <div class="col-md-4">
                                <input asp-for="Record.APTerms" placeholder="Ap Terms (Days)" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Address<span class="fw-bold text-danger"> *</span></label>
                            <div class="col-md-10">
                                <input asp-for="Record.Address" placeholder="Address" class="form-control form-control-sm" />
                                <span asp-validation-for="Record.Address" class="text-danger validation-error d-block"></span>
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">City</label>
                            <div class="col-md-4">
                                <input asp-for="Record.City" placeholder="City" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">TIN<span class="fw-bold text-danger"> *</span></label>
                            <div class="col-md-4">
                                <input asp-for="Record.TINNumber" placeholder="TIN Number" class="form-control form-control-sm" />
                                <span asp-validation-for="Record.TINNumber" class="text-danger validation-error d-block"></span>
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Country</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Country" placeholder="Country" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">Zip Code</label>
                            <div class="col-md-4">
                                <input asp-for="Record.ZipCode" placeholder="Zip Code" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Contact Person</label>
                            <div class="col-md-4">
                                <input asp-for="Record.ContactPerson" placeholder="Contact Person" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">Discount</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Discount" placeholder="Discount" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">A. Tel.Phone #:</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Phone1a" placeholder="eg. 8123-4567" class="form-control form-control-sm" />
                            </div>

                            <label class="col-md-2 col-form-label-sm text-end">A. Mobile.Phone #:</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Mobile1a" placeholder="eg. 091234567890" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Fax #</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Fax" placeholder="Fax Nos" class="form-control form-control-sm" />
                            </div>
                            <label class="col-md-2 col-form-label-sm text-end">Email Address</label>
                            <div class="col-md-4">
                                <input asp-for="Record.Email" placeholder="Email Address" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2 row">
                            <label class="col-md-2 col-form-label-sm text-end">Remarks</label>
                            <div class="col-md-10">
                                <input asp-for="Record.Remarks" placeholder="Remarks" class="form-control form-control-sm" />
                            </div>
                        </div>

                    </div>
                    <div class="col-md-4">
                        <div class="row mb-2">
                            <label class="col-md-6 col-form-label-sm text-end">Select Card Type To Print</label>
                            <div class="col-md-6">
                                <select asp-items="Model.Common.CardFileType" class="form-select form-select-sm searchable-select">
                                    <option value=""></option>
                                </select>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6">
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-sm btn-primary w-100">Print CardFile List</button>
                            </div>
                        </div>

                    </div>

                </div>



        
                @* START AUDIT TRAIL *@
                <div class="row g-2 align-items-center mt-5 border-top">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Created By</label>
                        <input asp-for="Record.CreatedBy" class="form-control form-control-sm" readonly="@Model.Common.IsAuditReadOnly" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Created Date</label>
                        <input asp-for="Record.CreatedDate" class="form-control form-control-sm" readonly="@Model.Common.IsAuditReadOnly" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Modified By</label>
                        <input asp-for="Record.ModifiedBy" class="form-control form-control-sm" readonly="@Model.Common.IsAuditReadOnly" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Modified Date</label>
                        <input asp-for="Record.ModifiedDate" class="form-control form-control-sm" readonly="@Model.Common.IsAuditReadOnly" />
                    </div>
                </div>
                @* END AUDIT TRAIL *@

            </form>

        </div>
    </div>


    @* VIEW CARD TYPE MODAL *@
    <div class="modal fade" id="ViewCardTypeModal" tabindex="-1" aria-labelledby="ViewCardTypeLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content shadow">

                <!-- Header -->
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-primary" id="ViewCardTypeLabel">
                        Please Select Card Type
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">
                    <form asp-action="SelectCardType" method="post">
                        <select asp-items="Model.Common.CardFileType" name="cardType"
                                class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value=""> --Select-- </option>
                        </select>
                    </form>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                </div>

            </div>
        </div>
    </div>


    @* VIEW LIST MODAL *@
    <div class="modal fade" id="ViewListModal" tabindex="-1" aria-labelledby="ViewListModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content shadow">

                <!-- Header -->
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-primary" id="ViewListModalLabel">
                        <i class="bi bi-search"></i> Search
                        <small class="text-secondary fw-normal">» Results</small>
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Search -->
                    <form asp-action="SearchViewList" method="post">
                        <div class="row mb-3">

                            <div class="col-md-5">
                                <input asp-for="Common.txtSearch" type="text" class="form-control" placeholder="Search Here..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search"></i> Search
                                </button>
                            </div>

         

                            <div class="col-md-3">
                                <button class="btn btn-primary w-100">
                                    <i class="bi bi-list"></i> Display All Records
                                </button>
                            </div>

                        </div>
                    </form>

                    <!-- START VIEW LIST GRID -->
                    <div class="table-responsive border rounded" style="height:400px; overflow-y:auto;">
                        <table class="table table-hover table-bordered table-sm mb-0 align-middle">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="text-center" style="width:90px;">Action</th>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Name2307</th>
                                    <th>Type</th>
                                    <th>TIN Number</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Common.ViewList != null && Model.Common.ViewList.Rows.Count > 0)
                                {
                                    @foreach (System.Data.DataRow row in Model.Common.ViewList.Rows)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <form asp-action="Select" method="post" class="d-inline">
                                                    <input type="hidden" name="PubPrimaryValue" value="@row["Code"]" />

                                                    <button type="submit" class="btn btn-link p-0 text-primary fw-semibold">
                                                        <i class="bi bi-check2-circle"></i> Select
                                                    </button>
                                                </form>
                                            </td>
                                            <td>@row["Code"]</td>
                                            <td>@row["Name"]</td>
                                            <td>@row["Name2307"]</td>
                                            <td>@row["Type"]</td>
                                            <td>@row["TINNumber"]</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            No records found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- END VIEW LIST GRID -->



                </div>

                <!-- Footer -->
                <div class="modal-footer">
                </div>

            </div>
        </div>
    </div>

</div>




@* SHOW MODAL *@
@if (ViewBag.ShowModal == true)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modal = new bootstrap.Modal(document.getElementById("ViewListModal"));
            modal.show();
        });
    </script>
}

@if (ViewBag.ShowCardTypeModal == true)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modalElement = document.getElementById("ViewCardTypeModal");

            var modal = new bootstrap.Modal(modalElement);

            modal.show();
        });
    </script>
}
